generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int      @id @default(autoincrement())
  name             String
  email            String   @unique
  password         String
  role             Role     @default(EMPLOYEE)
  isVerified       Boolean  @default(false)
  isActive         Boolean  @default(true)
  refreshTokenHash String?
  createdAt        DateTime @default(now())
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createdAt DateTime   @default(now())
  deletedAt DateTime?
  medicines Medicine[]
}

model Medicine {
  id         Int       @id @default(autoincrement())
  name       String
  price      Decimal   @db.Decimal(10, 2)
  stock      Int       @default(0)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  categoryId Int
  category   Category  @relation(fields: [categoryId], references: [id])

  suppliers  MedicineSupplier[]

  @@index([name])
  @@index([categoryId])
}

model Supplier {
  id                 Int       @id @default(autoincrement())
  name               String
  companyName        String?
  phone              String
  alternativePhone   String?
  email              String?
  address            String?
  taxNumber          String?
  commercialRegister String?
  contactPerson      String?
  notes              String?
  isActive           Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  medicines           MedicineSupplier[]

  @@index([name])
  @@index([phone])
  @@index([isActive])
}

model MedicineSupplier {
  medicineId Int
  supplierId Int

  medicine Medicine @relation(fields: [medicineId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  createdAt DateTime @default(now())

  @@id([medicineId, supplierId])
  @@index([supplierId])
}

enum Role {
  ADMIN
  PHARMACIST
  EMPLOYEE
}